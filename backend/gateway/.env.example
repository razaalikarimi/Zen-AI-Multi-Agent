# Zen AI API Gateway Environment Variables
PORT=8000
NODE_ENV=production

# Frontend Origin for CORS (e.g. your Vercel deployment URL)
FRONTEND_URL="https://zen-ai-multi-agent.vercel.app"

# AI Provider Keys (Required for AI answering and multi-agent document analysis)
GEMINI_API_KEY="your_gemini_api_key_here"
# or GOOGLE_API_KEY="your_gemini_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

# Security & Cryptographic Session Signing
SESSION_SECRET="your_custom_secure_hmac_session_secret"
SERVICE_AUTH_SECRET="your_custom_internal_service_auth_secret"

# Redis Cache & Concurrency (Optional on Free Tier - falls back to in-memory)
REDIS_URL="redis://localhost:6379"

# Database Connection (Optional if using MongoDB Atlas directly)
MONGODB_URL="mongodb+srv://<user>:<password>@cluster0.mongodb.net/zen_ai"

# Payments & Monetization (Optional)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Optional External Microservices (Leave blank if running unified single container)
# AUTH_SERVICE="https://zen-auth.onrender.com"
# CHAT_SERVICE="https://zen-chat.onrender.com"
# AGENT_SERVICE="https://zen-agent.onrender.com"
# BILLING_SERVICE="https://zen-billing.onrender.com"
