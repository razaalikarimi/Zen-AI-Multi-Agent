{
  "name": "zen-ai-multi-agent-platform",
  "version": "2.0.0",
  "description": "Enterprise-Grade Multi-Agent AI Orchestration Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node backend/gateway/index.js",
    "dev": "node backend/gateway/index.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend/gateway install && npm --prefix backend/services/auth install && npm --prefix backend/services/chat install && npm --prefix backend/services/billing install && npm --prefix backend/services/agent install && npm --prefix frontend install",
    "lint": "npm --prefix frontend run lint",
    "test": "node --test backend/test/*.test.js"
  },
  "keywords": [
    "multi-agent",
    "langgraph",
    "langchain",
    "enterprise-ai",
    "rag",
